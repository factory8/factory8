#!/bin/sh
# The agent's way to ask a human (agent-adapter spec); the adapter reports it as needs_input when the CLI exits.
printf '%s\n' "$*" > "${FACTORY8_ROOT:-/f8}-logs/state/question.md"
echo "Recorded. A human will answer later. Write your handoff note to ${FACTORY8_ROOT:-/f8}-logs/state/handoff.md, then end your turn."
