vars: {d2-config: {layout-engine: elk}}
direction: down
humans: "HUMANS — gates per route" {
  style: {fill: "#e8f5e9"; bold: true}
  h: "originator · product owner · engineer · code owner\nrelease manager · service owner\n(prototype: the author holds every role)"
}
forge: "Git forge (GitHub for the pilot)\nissue = intent · spec.md / plan.md on run branch\ndraft PR · reviews · branch protection" {style: {fill: "#fff8e1"; bold: true}}
cp: "CONTROL PLANE — trusted · one installation per client · on-prem k3s (NixOS)" {
  style: {fill: "#e3f2fd"; bold: true}
  intake: "Intake adapters (pollers)\n→ IntentEnvelope → IntakeWorkflow\nscreen · classify · reproduce · ask · draft intent"
  tmp: "Temporal (+ Postgres)\nstage · route · retries · timers · waits" {style: {fill: "#bbdefb"; bold: true}}
  wf: "SDLC workflows + workers + API\nTypeScript on Node LTS · replay-tested\na task queue per project · shared or project worker"
  obj: "Object storage (MinIO)\nevidence by content hash" {shape: cylinder}
  gw: "Gateways — scoped, short-lived per-run tokens" {
    style: {fill: "#bbdefb"}
    g: "Git (later — POC: token\nin sandbox, issue #1)"
    l: "LLM = LiteLLM\n(any provider; POC: static key)"
    d: "Deploy (per-env tools)"
  }
  ctrl: "Kubernetes API\nKata pod + PVC per step"
  builder: "Project agent builder\nNix dev shell · AGENTS.md · project.yaml\n→ image + sandbox template · checked"
  viewer: "Session viewer (third-party)\nread-only · token-gated"
  inbox: "Phone inbox → Collie\nquestion · link to session · token-gated"
  builder -> wf: "project template"
  intake -> tmp: starts runs
  wf -> tmp: runs on
  wf -> ctrl: "create · delete pod, then PVC\n(a question: pod only, PVC kept)"
}
ep: "EXECUTION PLANE — untrusted · disposable" {
  style: {fill: "#ffebee"; bold: true}
  sb: "Sandbox = Kata microVM\nroot inside OK: docker compose, installs\nadapter daemon → any CLI (claude · codex · pi …)" {style: {fill: "#ffcdd2"; bold: true}}
  pvc: "Step's PVC: workspace\ndeleted when the step ends\nnever credentials" {shape: cylinder}
  logs: "Session-log volume: a folder per step\n*.jsonl · state · handoff note\noutlives the step · never credentials" {shape: cylinder}
  proxy: "Egress proxy — allowlist\n→ read-only package mirrors"
  ci: "Secret-free CI runners\nfor agent branches"
  sb -> pvc
  sb -> logs: "its own folder only"
}
blocked: "BLOCKED: Temporal · k8s API · other sandboxes\ncluster network · open internet" {style: {fill: "#fff"; stroke: "#d32f2f"; font-color: "#d32f2f"; bold: true}}
out: "Outside: LLM providers · package registries\nJira/Confluence (linked)" {style: {fill: "#f3e5f5"}}

humans -> forge: "file issues · /accept · /answer\nedit spec/plan · approve PR · authorize release"
humans -> cp.wf: "f8 CLI (API): runs · progress\nanswer · accept · retry"
forge <- cp.intake: "poll issues (outbound only)"
forge -> cp.tmp: "commands → signals"
cp.ctrl -> ep.sb: "starts the Kata pod"
cp.gw <- ep.sb: "git push · model calls · deploy"
cp.obj <- ep.sb: "evidence\n(presigned URLs)"
cp.wf -> ep.sb: "start step · poll events\n(→ heartbeats)"
ep.sb -> ep.proxy: "installs"
ep.sb -> blocked: "" {style: {stroke: "#d32f2f"; stroke-width: 3; stroke-dash: 4}}
forge <- cp.gw.g: "push run branch"
forge <- cp.builder: "read project files\n(default branch)"
forge -> ep.ci: "agent branches"
cp.viewer <- ep.logs: "sessions\n(read-only, in place)"
cp.inbox -> cp.tmp: "waiting runs · answer signal"
humans -> cp.viewer: "read sessions\n(browser, phone)"
humans -> cp.inbox: "answer from the phone\n(Collie)"
cp.gw.l -> out
ep.proxy -> out
